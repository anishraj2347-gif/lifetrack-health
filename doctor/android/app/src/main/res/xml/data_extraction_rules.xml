<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: refuse both cloud backup and device-to-device transfer.
     Shares, notes and keys are sealed under a Keystore key that does not
     migrate, so a transferred copy would be unreadable anyway; refusing it
     is the honest behaviour. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
